root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
indent_style = space
indent_size = 4

[*.kts]
indent_style = space
indent_size = 4

[*.iss]
ij_formatter_enabled = false
max_line_length = off
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = true
