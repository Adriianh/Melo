CREATE TABLE session_new (
    instance_key TEXT    NOT NULL PRIMARY KEY,
    role         TEXT    NOT NULL,
    queue_json   TEXT    NOT NULL,
    queue_index  INTEGER NOT NULL DEFAULT -1,
    position_ms  INTEGER NOT NULL DEFAULT 0,
    saved_at     INTEGER NOT NULL,
    pid          INTEGER,
    host         TEXT
);

INSERT INTO session_new (instance_key, role, queue_json, queue_index, position_ms, saved_at, pid, host)
SELECT 'gui', 'gui', queue_json, queue_index, position_ms, saved_at, NULL, NULL
FROM session;

DROP TABLE session;

ALTER TABLE session_new RENAME TO session;
