CREATE TABLE IF NOT EXISTS session (
    instance_key TEXT    NOT NULL PRIMARY KEY,
    role         TEXT    NOT NULL,
    queue_json   TEXT    NOT NULL,
    queue_index  INTEGER NOT NULL DEFAULT -1,
    position_ms  INTEGER NOT NULL DEFAULT 0,
    saved_at     INTEGER NOT NULL,
    pid          INTEGER,
    host         TEXT
);

upsertSession:
INSERT OR REPLACE INTO session (instance_key, role, queue_json, queue_index, position_ms, saved_at, pid, host)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectSession:
SELECT * FROM session WHERE instance_key = ?;

deleteSession:
DELETE FROM session WHERE instance_key = ?;
